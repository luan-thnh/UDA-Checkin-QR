# ============ Dashboard web (apps/dashboard) ============
# Chay local: cp .env.example .env
# Deploy Vercel: paste cac bien nay vao Project -> Settings -> Environment Variables.
# LUU Y: bien VITE_* duoc build thang vao JS nen ai mo web deu thay -> chi de URL cong khai.

# URL API. Local: http://localhost:3001. Production: https://<ten-api>.vercel.app
VITE_API_URL=http://localhost:3001

# (Optional) AppID Zalo de hien link QR day du. Khong co van chay (QR hien session id).
VITE_MINI_APP_ID=
