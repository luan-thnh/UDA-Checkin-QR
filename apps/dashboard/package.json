{
  "name": "@checkin/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "predev": "pnpm --filter @checkin/shared build",
    "build": "tsc --noEmit && vite build",
    "prebuild": "pnpm --filter @checkin/shared build",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist-test/*.test.js",
    "pretest": "tsc -p tsconfig.test.json",
    "lint": "echo \"(P0) no eslint yet\""
  },
  "dependencies": {
    "@checkin/shared": "workspace:*",
    "lucide-react": "^1.49.0",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
