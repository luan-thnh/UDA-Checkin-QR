# ============ API (apps/api) ============
# Chay local: cp .env.example .env (server Node doc file data/db.json khi thieu Supabase)

# Port chay local (Vercel tu set PORT, khong can)
PORT=3001

# --- Admin (bat buoc: ca local + Vercel) ---
# Email/pass de login dashboard. Dat mat khau manh o production!
ADMIN_EMAIL=admin@truong.edu.vn
ADMIN_PASSWORD=doi-mat-khau-nay-di
# Token API dung cho moi route admin. Tu sinh 1 chuoi dai ngau nhien cho production.
ADMIN_TOKEN=dev-admin-token

# --- Supabase Postgres (bat buoc tren Vercel, optional local) ---
# Tao project free tai https://supabase.com -> chay apps/api/migrations/001_init.sql
# trong SQL Editor -> lay 2 gia tri duoi ve paste vao Vercel Env Vars.
# Local khong set 2 bien nay thi API chay memory + file apps/api/data/db.json.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role... (GIU KIN, chi de server/Vercel, KHONG de lo)

# --- Zalo Mini App (2 loai ID KHAC NHAU, dung nham la QR sai) ---
# 1) MINI_APP_ID: lay tai https://miniapp.zaloplatforms.com/ (tao Mini App moi,
#    chon/link toi Zalo App ben duoi). Dung de sinh link QR zalo.me/s/<MINI_APP_ID>/?session=...
#    va dien vao apps/miniapp/app-config.json
MINI_APP_ID=
# 2) ZALO_APP_ID + SECRET: lay tai https://developers.zalo.me/ (man hinh ID ung dung
#    nhu anh ban chup). Chi dung o server de doi token GPS (POST /api/location/resolve).
ZALO_APP_ID=
ZALO_APP_SECRET=GIU-KIN-chi-de-server
