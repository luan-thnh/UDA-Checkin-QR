{
  "name": "checkin-qr",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "description": "Zalo Mini App check-in sinh vien + Dashboard quan ly + API",
  "scripts": {
    "dev:api": "pnpm --filter @checkin/api dev",
    "dev:dashboard": "pnpm --filter @checkin/dashboard dev",
    "dev:miniapp": "pnpm --filter @checkin/miniapp dev",
    "build": "pnpm -r build",
